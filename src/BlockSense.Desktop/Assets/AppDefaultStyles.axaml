<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Design.PreviewWith>
    <Border Padding="20">
      <!-- Add Controls for Previewer Here -->
    </Border>
  </Design.PreviewWith>
    
	<!-- Default TextBlock style -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Montserrat}"/>
    </Style>
	
	<!-- Default light brown Separator line -->
	<Style Selector="Border.DefaultSeparator">
		<Setter Property="Height" Value="1"/>
		<Setter Property="Background" Value="#D4C9A8"/>
		<Setter Property="CornerRadius" Value="100"/>
		<Setter Property="BoxShadow" Value="5 5 10 0 Black"/>
	</Style>
	
	<!-- 2FA Code Entry Styles -->
	<Style Selector="Border.codeDigit">
		<Setter Property="Width" Value="50"/>
		<Setter Property="Height" Value="60"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="Margin" Value="8"/>
		<Setter Property="Background" Value="#FBF7F1"/>
		<Setter Property="BorderThickness" Value="2"/>
		<Setter Property="BorderBrush" Value="#E6DDD1"/>
	</Style>
	
	<Style Selector="TextBlock.digitText">
		<Setter Property="FontSize" Value="28"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="#4A4238"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	
	<!-- Fade in color transition -->
	<Style Selector="Button ContentPresenter">
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.25"/>
				<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>
	
	<!-- Scale up transition -->
	<Style Selector="Button:not(#PART_CloseButton):not(#PART_MinimizeButton):pointerover">
		<Setter Property="RenderTransform" Value="scale(1.02)" />
	</Style>
	
	<Style Selector="Button:pressed">
		<Setter Property="RenderTransform" Value="scale(1)"/>
	</Style>
	
	<!-- Default dark brown button -->
	<Style Selector="Button.DefaultDarkBrown">
		<Setter Property="Width" Value="280"/>
		<Setter Property="Height" Value="34"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="CornerRadius" Value="20"/>
		<Setter Property="Background" Value="#6D4C41"/>
	</Style>
	
	<Style Selector="Button.DefaultDarkBrown:pointerover ContentPresenter">
		<Setter Property="Background" Value="#5D3F36"/>
	</Style>
	
	<Style Selector="Button.DefaultDarkBrown:pressed ContentPresenter">
		<Setter Property="Background" Value="#5D3F36"/>
	</Style>
	
	<!-- Default light brown button -->
	<Style Selector="Button.DefaultLightBrown">
		<Setter Property="Width" Value="280"/>
		<Setter Property="Height" Value="34"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="CornerRadius" Value="20"/>
		<Setter Property="Background" Value="#E6C8A0"/>
	</Style>
	
	<Style Selector="Button.DefaultLightBrown:pointerover ContentPresenter">
		<Setter Property="Background" Value="#D4B38C"/>
	</Style>
	
	<Style Selector="Button.DefaultLightBrown:pressed ContentPresenter">
		<Setter Property="Background" Value="#D4B38C"/>
	</Style>
	
	<!-- Default white button -->
	<Style Selector="Button.DefaultWhite">
		<Setter Property="Width" Value="120"/>
		<Setter Property="Height" Value="30"/>
		<Setter Property="Background" Value="White"/>
		<Setter Property="Foreground" Value="Gray"/>
		<Setter Property="CornerRadius" Value="20"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
	</Style>

	<Style Selector="Button.DefaultWhite:pointerover ContentPresenter">
		<Setter Property="Background" Value="LightGray"/>
		<Setter Property="Foreground" Value="#6E6E6E"/>
	</Style>
	
	<Style Selector="Button.DefaultWhite:pressed ContentPresenter">
		<Setter Property="Background" Value="LightGray"/>
		<Setter Property="Foreground" Value="#6E6E6E"/>
	</Style>

	<Style Selector="Button.DefaultDisable">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="#E57373"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="20"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
	</Style>

	<Style Selector="Button.DefaultDisable:pointerover ContentPresenter">
		<Setter Property="BorderBrush" Value="#E57373"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>
	
	<Style Selector="Button.DefaultDisable:pressed ContentPresenter">
		<Setter Property="BorderBrush" Value="#E57373"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>

	<!-- Red circular close button with Mac design -->
	<Style Selector="Button.MacButton">
		<Setter Property="Width" Value="14"/>
		<Setter Property="Height" Value="14"/>
		<Setter Property="HorizontalAlignment" Value="Right"/>
		<Setter Property="CornerRadius" Value="7"/>
		<Setter Property="Background" Value="Red"/>
		<Setter Property="Padding" Value="0"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Grid>
					<!-- Button Background (visible circle) -->
					<Border
						Background="{TemplateBinding Background}"
						CornerRadius="{TemplateBinding CornerRadius}"
						Width="{TemplateBinding Width}"
						Height="{TemplateBinding Height}"/>
					
					<!-- X Icon -->
					<Path
						 Width="6"
						 Height="6"
						 HorizontalAlignment="Center"
						 VerticalAlignment="Center"
						 Stretch="Uniform"
						 Stroke="Black"
						 StrokeThickness="1.25"
						 Margin="0.5 0 0 0"
						 Data="M 0,0 L 6,6 M 6,0 L 0,6"
						 IsVisible="False"/>
				</Grid>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="Button.MacButton:pointerover Path">
		<Setter Property="IsVisible" Value="True"/>
	</Style>

	<!-- Default textbox used in Login/Register -->
	<Style Selector="TextBox">
		<Setter Property="FontFamily" Value="{DynamicResource Montserrat}"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="Background" Value="#B99978"/>
		<Setter Property="Foreground" Value="#6F4E37"/>
		<Setter Property="BorderBrush" Value="#D2B48C"/>
		<Setter Property="BorderThickness" Value="2"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
	</Style>
	
	<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="#D2B48C"/>
		<Setter Property="Background" Value="#B99978"/>
	</Style>

	<Style Selector="TextBox:pointerover, TextBox:focus">
		<Setter Property="Foreground" Value="#6F4E37"/>
	</Style>

	<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="#D2B48C"/>
		<Setter Property="Background" Value="#B99978"/>
	</Style>

	<!-- CheckBox style with fade in/out transition -->
	<Style Selector="CheckBox">
		<Setter Property="Foreground" Value="#5C5C5C"/>
		<Setter Property="BorderBrush" Value="#654321"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Grid
                    Background="Transparent"
                    VerticalAlignment="Center"
                    ColumnDefinitions="Auto,*">
					<Border Name="PART_CheckBoxBorder"
							Width="18" Height="18"
							Margin="0,0,8,0"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="2"
							CornerRadius="6">
						<Canvas Width="18" Height="18">
							<Path Name="PART_CheckMark"
								  Opacity="0"
								  Data="M 4,9 L 8,13 L 14,5"
								  Stroke="#654321"
								  StrokeThickness="2">
								<Path.Transitions>
									<Transitions>
										<DoubleTransition
											Property="Opacity" Duration="0:0:0.2"/>
										<TransformOperationsTransition
											Property="RenderTransform" Duration="0:0:0.2"/>
									</Transitions>
								</Path.Transitions>
							</Path>
						</Canvas>
					</Border>
					<ContentPresenter Name="PART_ContentPresenter"
                                    Grid.Column="1"
                                    Content="{TemplateBinding Content}"/>
				</Grid>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="CheckBox ContentPresenter">
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Foreground" Duration="0:0:0.2"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="CheckBox:pointerover ContentPresenter">
		<Setter Property="Foreground" Value="#343434"/>
	</Style>

	<Style Selector="CheckBox:checked">
		<Setter Property="Foreground" Value="#5C5C5C"/>
	</Style>

	<Style Selector="CheckBox:checked /template/ Border#PART_CheckBoxBorder">
		<Setter Property="BorderThickness" Value="0"/>
	</Style>
	
	<Style Selector="CheckBox:checked /template/ Path#PART_CheckMark">
		<Setter Property="Opacity" Value="1"/>
		<Setter Property="RenderTransform">
			<ScaleTransform ScaleX="1" ScaleY="1"/>
		</Setter>
	</Style>

	<!-- Lightweight ScrollBar with transparent background -->
	<Style Selector="ScrollBar">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="MinWidth" Value="4"/>
	</Style>
	
	
	<Style Selector="ScrollBar:vertical">
		<Setter Property="Width" Value="4"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent"
						Padding="0"
						Margin="0 0 0 20">
					<Track IsDirectionReversed="True"
						   Maximum="{TemplateBinding Maximum}"
						   Minimum="{TemplateBinding Minimum}"
						   Orientation="Vertical"
						   ViewportSize="{TemplateBinding ViewportSize}"
						   Value="{TemplateBinding Value, Mode=TwoWay}">
						<Track.Thumb>
							<Thumb MinHeight="30">
								<Thumb.Template>
									<ControlTemplate>
										<Border Background="LightGray"
												CornerRadius="10"
												Opacity="0.6"/>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Track.Thumb>
					</Track>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="ScrollBar.NoBottomMargin:vertical">
		<Setter Property="Width" Value="4"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent"
						Padding="0"
						Margin="0">
					<Track IsDirectionReversed="True"
						   Maximum="{TemplateBinding Maximum}"
						   Minimum="{TemplateBinding Minimum}"
						   Orientation="Vertical"
						   ViewportSize="{TemplateBinding ViewportSize}"
						   Value="{TemplateBinding Value, Mode=TwoWay}">
						<Track.Thumb>
							<Thumb MinHeight="30">
								<Thumb.Template>
									<ControlTemplate>
										<Border Background="Gray"
												CornerRadius="10"
												Opacity="0.6"/>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Track.Thumb>
					</Track>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- ContextMenu with disabled background transition and reduced size -->
	<!-- Not ideal for more than 2 Menu items !!! -->
	<Style Selector="ContextMenu">
		<Setter Property="Background" Value="White"/>
		<Setter Property="CornerRadius" Value="40"/>
		<Setter Property="BorderBrush" Value="#6B6B6B"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.4" Easing="CubicEaseOut"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="ContextMenu:pointerover">
		<Setter Property="Background" Value="#FAFAFA"/>
	</Style>

	<Style Selector="MenuItem">
		<Setter Property="Foreground" Value="Gray"/>
		<Setter Property="FontSize" Value="10"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontFamily" Value="{DynamicResource Montserrat}"/>
		<Setter Property="Padding" Value="11 5"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent"
						Padding="{TemplateBinding Padding}">
					<ContentPresenter Content="{TemplateBinding Header}"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Stretch"/>
				</Border>
			</ControlTemplate>
		</Setter>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Foreground" Duration="0:0:0.4" Easing="CubicEaseOut"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="MenuItem:pointerover">
		<Setter Property="Foreground" Value="#6B6B6B"/>
	</Style>
</Styles>