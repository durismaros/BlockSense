<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


	<Design.PreviewWith>
		<Border Padding="20">
			<!-- Add Controls for Previewer Here -->
		</Border>
	</Design.PreviewWith>

	<!-- Default TextBlock style -->
	<Style Selector="TextBlock">
		<Setter Property="FontFamily" Value="{DynamicResource Montserrat}"/>
	</Style>

	<!-- Default light brown Separator line -->
	<Style Selector="Border.DefaultSeparator">
		<Setter Property="Height" Value="1"/>
		<Setter Property="Background" Value="#D4C9A8"/>
		<Setter Property="CornerRadius" Value="100"/>
		<Setter Property="BoxShadow" Value="5 5 10 0 Black"/>
	</Style>

	<!-- 2FA Code Entry Styles -->
	<Style Selector="Border.CodeDigit">
		<Setter Property="Width" Value="50"/>
		<Setter Property="Height" Value="60"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="Margin" Value="8"/>
		<Setter Property="Background" Value="#FBF7F1"/>
		<Setter Property="BorderThickness" Value="2"/>
		<Setter Property="BorderBrush" Value="#E6DDD1"/>
	</Style>

	<Style Selector="TextBlock.DigitText">
		<Setter Property="FontSize" Value="28"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="#4A4238"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<Style Selector="TextBlock.DigitSeparator">
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="Foreground" Value="#8B6B4A"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Margin" Value="6 0"/>
	</Style>

	<!-- Default Button Styles -->
	<!-- Fade in color transition -->
	<Style Selector="Button ContentPresenter">
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.25"/>
				<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"/>
				<DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Scale up transition -->
	<Style Selector="Button:not(#PART_CloseButton):not(#PART_MinimizeButton):pointerover">
		<Setter Property="RenderTransform" Value="scale(1.02)"/>
	</Style>

	<Style Selector="Button:pressed">
		<Setter Property="RenderTransform" Value="scale(1)"/>
	</Style>

	<!-- Default dark brown button -->
	<Style Selector="Button.DefaultDarkBrown">
		<Setter Property="Width" Value="280"/>
		<Setter Property="Height" Value="34"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="CornerRadius" Value="20"/>
		<Setter Property="Background" Value="#6D4C41"/>
	</Style>

	<Style Selector="Button.DefaultDarkBrown:pointerover ContentPresenter, Button.DefaultDarkBrown:pressed ContentPresenter">
		<Setter Property="Background" Value="#5D3F36"/>
	</Style>

	<!-- Default light brown button -->
	<Style Selector="Button.DefaultLightBrown">
		<Setter Property="Width" Value="280"/>
		<Setter Property="Height" Value="34"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="CornerRadius" Value="20"/>
		<Setter Property="Background" Value="#D9B78A"/>
	</Style>

	<Style Selector="Button.DefaultLightBrown:pointerover ContentPresenter, Button.DefaultLightBrown:pressed ContentPresenter">
		<Setter Property="Background" Value="#C29A72"/>
	</Style>

	<!-- Default white button -->
	<Style Selector="Button.DefaultWhite">
		<Setter Property="Width" Value="120"/>
		<Setter Property="Height" Value="32"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Background" Value="#FBF7F1"/>
		<Setter Property="Foreground" Value="#7A7A7A"/>
		<Setter Property="CornerRadius" Value="20"/>
	</Style>

	<Style Selector="Button.DefaultWhite:pointerover ContentPresenter, Button.DefaultWhite:pressed ContentPresenter">
		<Setter Property="Background" Value="#E8E2DA"/>
		<Setter Property="Foreground" Value="#6E6E6E"/>
	</Style>


	<Style Selector="Button.DefaultDisable">
		<Setter Property="Width" Value="120"/>
		<Setter Property="Height" Value="32"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="#E57373"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="20"/>
	</Style>

	<Style Selector="Button.DefaultDisable:pointerover ContentPresenter, Button.DefaultDisable:pressed ContentPresenter">
		<Setter Property="BorderBrush" Value="#E57373"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>

	<Style Selector="Button.ConfirmDisable">
		<Setter Property="Width" Value="120"/>
		<Setter Property="Height" Value="32"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Background" Value="#E57373"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="CornerRadius" Value="20"/>
	</Style>

	<Style Selector="Button.ConfirmDisable:pointerover ContentPresenter, Button.ConfirmDisable:pressed ContentPresenter">
		<Setter Property="Background" Value="#DE4040"/>
		<Setter Property="Opacity" Value="1"/>
	</Style>

	<Style Selector="Button.BackupCodeToggle">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="Padding" Value="8 4"/>
		<Setter Property="CornerRadius" Value="6"/>
	</Style>

	<Style Selector="Button.ForgotPassword">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="Padding" Value="8 4"/>
		<Setter Property="CornerRadius" Value="6"/>
	</Style>

	<Style Selector="Button.ForgotPassword:pointerover ContentPresenter, Button.ForgotPassword:pressed ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<Style Selector="Button.MacOsCloseButton">
		<Setter Property="Width" Value="16"/>
		<Setter Property="Height" Value="16"/>
		<Setter Property="HorizontalContentAlignment" Value="Right"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="0"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Grid Width="16" Height="16">

					<!-- Red circle -->
					<Ellipse x:Name="Circle"
							 Fill="#FF5F57"
							 Stroke="#E0443E"
							 StrokeThickness="1"/>

					<!-- X (hidden by default, macOS-style) -->
					<Path x:Name="CloseIcon"
						  Data="M5,5 L11,11 M11,5 L5,11"
						  Stroke="#4C0000"
						  StrokeThickness="1.4"
						  StrokeLineCap="Round"
						  Opacity="0"/>
				</Grid>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Hover behavior -->
	<Style Selector="Button.MacOsCloseButton:pointerover Path#CloseIcon, Button.MacOsCloseButton:pressed Path#CloseIcon">
		<Setter Property="Opacity" Value="0.85"/>
	</Style>

	<!-- Pressed state (subtle darkening) -->
	<Style Selector="Button.MacOsCloseButton:pressed Ellipse#Circle">
		<Setter Property="Fill" Value="#E0443E"/>
	</Style>

	<Style Selector="TextBox">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="#3E2723"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="LetterSpacing" Value="1"/>
		<Setter Property="BorderBrush" Value="#5D4037"/>
		<Setter Property="BorderThickness" Value="0 0 0 2"/>
		<Setter Property="CaretBrush" Value="#3E2723"/>
		<Setter Property="Padding" Value="12 8"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="CornerRadius" Value="0"/>
		<Setter Property="FontFamily" Value="{DynamicResource Montserrat}"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="TextBox /template/ TextBlock#PART_Watermark">
		<Setter Property="Opacity" Value="0.6"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Foreground" Duration="0:0:0.1"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="#4E342E"/>
		<Setter Property="BorderThickness" Value="0 0 0 2"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="TextBox:pointerover ContentPresenter, TextBox:focus ContentPresenter">
		<Setter Property="Foreground" Value="#3E2723"/>
	</Style>

	<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="#4E342E"/>
		<Setter Property="BorderThickness" Value="0 0 0 2"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>


	<!-- CheckBox style with fade in/out transition -->
	<Style Selector="CheckBox">
		<Setter Property="Foreground" Value="#5C5C5C"/>
		<Setter Property="BorderBrush" Value="#654321"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Grid
				Background="Transparent"
				VerticalAlignment="Center"
				ColumnDefinitions="Auto,*">
					<Border Name="PART_CheckBoxBorder"
							Width="18" Height="18"
							Margin="0,0,8,0"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="2"
							CornerRadius="6">
						<Canvas Width="18" Height="18">
							<Path Name="PART_CheckMark"
								  Opacity="0"
								  Data="M 4,9 L 8,13 L 14,5"
								  Stroke="#654321"
								  StrokeThickness="2">
								<Path.Transitions>
									<Transitions>
										<DoubleTransition
										Property="Opacity" Duration="0:0:0.2"/>
										<TransformOperationsTransition
										Property="RenderTransform" Duration="0:0:0.2"/>
									</Transitions>
								</Path.Transitions>
							</Path>
						</Canvas>
					</Border>
					<ContentPresenter Name="PART_ContentPresenter"
									  Grid.Column="1"
									  Content="{TemplateBinding Content}"/>
				</Grid>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="CheckBox ContentPresenter">
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Foreground" Duration="0:0:0.2"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="CheckBox:pointerover ContentPresenter">
		<Setter Property="Foreground" Value="#343434"/>
	</Style>

	<Style Selector="CheckBox:checked">
		<Setter Property="Foreground" Value="#5C5C5C"/>
	</Style>

	<Style Selector="CheckBox:checked /template/ Border#PART_CheckBoxBorder">
		<Setter Property="BorderThickness" Value="0"/>
	</Style>

	<Style Selector="CheckBox:checked /template/ Path#PART_CheckMark">
		<Setter Property="Opacity" Value="1"/>
		<Setter Property="RenderTransform">
			<ScaleTransform ScaleX="1" ScaleY="1"/>
		</Setter>
	</Style>

	<!-- Lightweight ScrollBar with transparent background -->
	<Style Selector="ScrollBar">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="MinWidth" Value="4"/>
	</Style>


	<Style Selector="ScrollBar:vertical">
		<Setter Property="Width" Value="4"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent"
						Margin="0 28">
					<Track IsDirectionReversed="True"
						   Maximum="{TemplateBinding Maximum}"
						   Minimum="{TemplateBinding Minimum}"
						   Orientation="Vertical"
						   ViewportSize="{TemplateBinding ViewportSize}"
						   Value="{TemplateBinding Value, Mode=TwoWay}">
						<Track.Thumb>
							<Thumb MinHeight="30">
								<Thumb.Template>
									<ControlTemplate>
										<Border Background="LightGray"
												CornerRadius="10"
												Opacity="0.6"/>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Track.Thumb>
					</Track>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<Style Selector="ScrollBar.NoBottomMargin:vertical">
		<Setter Property="Width" Value="4"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent"
						Padding="0"
						Margin="0">
					<Track IsDirectionReversed="True"
						   Maximum="{TemplateBinding Maximum}"
						   Minimum="{TemplateBinding Minimum}"
						   Orientation="Vertical"
						   ViewportSize="{TemplateBinding ViewportSize}"
						   Value="{TemplateBinding Value, Mode=TwoWay}">
						<Track.Thumb>
							<Thumb MinHeight="30">
								<Thumb.Template>
									<ControlTemplate>
										<Border Background="Gray"
												CornerRadius="10"
												Opacity="0.6"/>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Track.Thumb>
					</Track>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- ContextMenu with disabled background transition and reduced size -->
	<!-- Not ideal for more than 2 Menu items !!! -->
	<Style Selector="ContextMenu">
		<Setter Property="Background" Value="White"/>
		<Setter Property="CornerRadius" Value="40"/>
		<Setter Property="BorderBrush" Value="#6B6B6B"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.4" Easing="CubicEaseOut"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="ContextMenu:pointerover">
		<Setter Property="Background" Value="#FAFAFA"/>
	</Style>

	<Style Selector="MenuItem">
		<Setter Property="Foreground" Value="Gray"/>
		<Setter Property="FontSize" Value="10"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontFamily" Value="{DynamicResource Montserrat}"/>
		<Setter Property="Padding" Value="11 5"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent"
						Padding="{TemplateBinding Padding}">
					<ContentPresenter Content="{TemplateBinding Header}"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Stretch"/>
				</Border>
			</ControlTemplate>
		</Setter>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Foreground" Duration="0:0:0.4" Easing="CubicEaseOut"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="MenuItem:pointerover">
		<Setter Property="Foreground" Value="#6B6B6B"/>
	</Style>

	<Style Selector="Path.ReavealPasswordEyeIcon">
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Data" Value="M1,12C3.5,7.5 7.5,5 12,5C16.5,5 20.5,7.5 23,12C20.5,16.5 16.5,19 12,19C7.5,19 3.5,16.5 1,12Z
		M12,9A3,3 0 1 0 12,15A3,3 0 1 0 12,9Z"/>
		<Setter Property="Stroke" Value="#4E342E"/>
		<Setter Property="StrokeThickness" Value="1.8"/>
		<Setter Property="StrokeLineCap" Value="Round"/>
		<Setter Property="StrokeJoin" Value="Round"/>
		<Setter Property="Fill" Value="Transparent"/>
	</Style>

	<Style Selector="Path.ReavealPasswordCrossIcon">
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Data" Value="M5,5L19,19"/>
		<Setter Property="Stroke" Value="#4E342E"/>
		<Setter Property="StrokeThickness" Value="1.8"/>
		<Setter Property="StrokeLineCap" Value="Round"/>
		<Setter Property="StrokeJoin" Value="Round"/>
		<Setter Property="Fill" Value="Transparent"/>
		<Setter Property="IsVisible" Value="False"/>
	</Style>

</Styles>
