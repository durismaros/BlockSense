<Styles xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Design.PreviewWith>
		<Border Padding="20">
			<!-- Add Controls for Previewer Here -->
		</Border>
	</Design.PreviewWith>


	<!-- Default font for all TextBlock elements -->
	<Style Selector="TextBlock">
		<Setter Property="FontFamily" Value="{DynamicResource Montserrat}"/>
	</Style>


	<!-- Thin light-brown horizontal rule used between sections -->
	<Style Selector="Border.DefaultSeparator">
		<Setter Property="Height" Value="1"/>
		<Setter Property="Background" Value="#D4C9A8"/>
		<Setter Property="CornerRadius" Value="100"/>
		<Setter Property="BoxShadow" Value="5 5 10 0 Black"/>
	</Style>


	<!-- Single digit cell in the 2FA code entry row -->
	<Style Selector="Border.CodeDigit">
		<Setter Property="Width" Value="50"/>
		<Setter Property="Height" Value="60"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="Margin" Value="8"/>
		<Setter Property="Background" Value="#FBF7F1"/>
		<Setter Property="BorderThickness" Value="2"/>
		<Setter Property="BorderBrush" Value="#E6DDD1"/>
	</Style>

	<!-- Large digit displayed inside a CodeDigit cell -->
	<Style Selector="TextBlock.DigitText">
		<Setter Property="FontSize" Value="28"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="#4A4238"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<!-- Dash separator rendered between groups of 2FA digits -->
	<Style Selector="TextBlock.DigitSeparator">
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="Foreground" Value="#8B6B4A"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Margin" Value="6 0"/>
	</Style>


	<!-- Smooth background colour fade on all button content presenters -->
	<Style Selector="Button ContentPresenter">
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.25"/>
				<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"/>
				<DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Slight scale-up on pointer hover (excludes window chrome buttons) -->
	<Style Selector="Button:not(#PART_CloseButton):not(#PART_MinimizeButton):pointerover">
		<Setter Property="RenderTransform" Value="scale(1.02)"/>
	</Style>

	<!-- Return to natural scale on press -->
	<Style Selector="Button:pressed">
		<Setter Property="RenderTransform" Value="scale(1)"/>
	</Style>


	<!-- Primary action button with a dark-brown fill -->
	<Style Selector="Button.DefaultDarkBrown">
		<Setter Property="Width" Value="280"/>
		<Setter Property="Height" Value="34"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="CornerRadius" Value="20"/>
		<Setter Property="Background" Value="#6D4C41"/>
	</Style>

	<Style Selector="Button.DefaultDarkBrown:pointerover ContentPresenter,
	Button.DefaultDarkBrown:pressed    ContentPresenter">
		<Setter Property="Background" Value="#5D3F36"/>
	</Style>

	<!-- Secondary action button with a light-brown fill -->
	<Style Selector="Button.DefaultLightBrown">
		<Setter Property="Width" Value="280"/>
		<Setter Property="Height" Value="34"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="CornerRadius" Value="20"/>
		<Setter Property="Background" Value="#D9B78A"/>
	</Style>

	<Style Selector="Button.DefaultLightBrown:pointerover ContentPresenter,
	Button.DefaultLightBrown:pressed    ContentPresenter">
		<Setter Property="Background" Value="#C29A72"/>
	</Style>

	<!-- Tertiary / ghost button with a white fill -->
	<Style Selector="Button.DefaultWhite">
		<Setter Property="Width" Value="120"/>
		<Setter Property="Height" Value="32"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Background" Value="#FBF7F1"/>
		<Setter Property="Foreground" Value="#7A7A7A"/>
		<Setter Property="CornerRadius" Value="20"/>
	</Style>

	<Style Selector="Button.DefaultWhite:pointerover ContentPresenter,
	Button.DefaultWhite:pressed    ContentPresenter">
		<Setter Property="Background" Value="#E8E2DA"/>
		<Setter Property="Foreground" Value="#6E6E6E"/>
	</Style>

	<!-- Outlined destructive button shown before a disable action is confirmed -->
	<Style Selector="Button.DefaultDisable">
		<Setter Property="Width" Value="120"/>
		<Setter Property="Height" Value="32"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="#E57373"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="20"/>
	</Style>

	<Style Selector="Button.DefaultDisable:pointerover ContentPresenter,
	Button.DefaultDisable:pressed    ContentPresenter">
		<Setter Property="BorderBrush" Value="#E57373"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>

	<!-- Filled destructive button used to confirm a disable action -->
	<Style Selector="Button.ConfirmDisable">
		<Setter Property="Width" Value="120"/>
		<Setter Property="Height" Value="32"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Background" Value="#E57373"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="CornerRadius" Value="20"/>
	</Style>

	<Style Selector="Button.ConfirmDisable:pointerover ContentPresenter,
	Button.ConfirmDisable:pressed    ContentPresenter">
		<Setter Property="Background" Value="#DE4040"/>
		<Setter Property="Opacity" Value="1"/>
	</Style>

	<!-- Transparent toggle used to switch between code and backup-code views -->
	<Style Selector="Button.BackupCodeToggle">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="Padding" Value="8 4"/>
		<Setter Property="CornerRadius" Value="6"/>
	</Style>

	<!-- Inline link-style button for the "Forgot password?" flow -->
	<Style Selector="Button.ForgotPassword">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="Padding" Value="8 4"/>
		<Setter Property="CornerRadius" Value="6"/>
	</Style>

	<Style Selector="Button.ForgotPassword:pointerover ContentPresenter,
	Button.ForgotPassword:pressed    ContentPresenter">
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<!-- macOS-style circular close button (red dot with an X on hover) -->
	<Style Selector="Button.MacOsCloseButton">
		<Setter Property="Width" Value="16"/>
		<Setter Property="Height" Value="16"/>
		<Setter Property="HorizontalContentAlignment" Value="Right"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="Padding" Value="0"/>

		<Setter Property="Template">
			<ControlTemplate>
				<Grid Width="16" Height="16">

					<!-- Red circle base -->
					<Ellipse x:Name="Circle"
							 Fill="#FF5F57"
							 Stroke="#E0443E"
							 StrokeThickness="1"/>

					<!-- X icon — hidden by default, revealed on hover -->
					<Path x:Name="CloseIcon"
						  Data="M5,5 L11,11 M11,5 L5,11"
						  Stroke="#4C0000"
						  StrokeThickness="1.4"
						  StrokeLineCap="Round"
						  Opacity="0"/>
				</Grid>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Reveal the X icon when the button is hovered or pressed -->
	<Style Selector="Button.MacOsCloseButton:pointerover Path#CloseIcon,
	Button.MacOsCloseButton:pressed    Path#CloseIcon">
		<Setter Property="Opacity" Value="0.85"/>
	</Style>

	<!-- Slightly darken the circle when pressed -->
	<Style Selector="Button.MacOsCloseButton:pressed Ellipse#Circle">
		<Setter Property="Fill" Value="#E0443E"/>
	</Style>


	<Style Selector="TextBox">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="#3E2723"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="LetterSpacing" Value="1"/>
		<Setter Property="BorderBrush" Value="#5D4037"/>
		<Setter Property="BorderThickness" Value="0 0 0 2"/>
		<Setter Property="CaretBrush" Value="#3E2723"/>
		<Setter Property="Padding" Value="12 8"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="CornerRadius" Value="0"/>
		<Setter Property="FontFamily" Value="{DynamicResource Montserrat}"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Dim the placeholder text slightly -->
	<Style Selector="TextBox /template/ TextBlock#PART_Watermark">
		<Setter Property="Opacity" Value="0.6"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Foreground" Duration="0:0:0.1"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Darken the underline border on hover -->
	<Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="#4E342E"/>
		<Setter Property="BorderThickness" Value="0 0 0 2"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Keep text colour consistent on hover and focus -->
	<Style Selector="TextBox:pointerover ContentPresenter,
	TextBox:focus       ContentPresenter">
		<Setter Property="Foreground" Value="#3E2723"/>
	</Style>

	<!-- Darken the underline border on focus -->
	<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="#4E342E"/>
		<Setter Property="BorderThickness" Value="0 0 0 2"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>


	<Style Selector="TextBox.NoUnderline">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="#3E2723"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="LetterSpacing" Value="1"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
		<Setter Property="CaretBrush" Value="#3E2723"/>
		<Setter Property="Padding" Value="12 8"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="CornerRadius" Value="0"/>
		<Setter Property="FontFamily" Value="{DynamicResource Montserrat}"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Dim the placeholder text slightly -->
	<Style Selector="TextBox.NoUnderline /template/ TextBlock#PART_Watermark">
		<Setter Property="Opacity" Value="0.6"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Foreground" Duration="0:0:0.1"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Darken the underline border on hover -->
	<Style Selector="TextBox.NoUnderline:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
	</Style>

	<!-- Darken the underline border on focus -->
	<Style Selector="TextBox.NoUnderline:focus /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0"/>
	</Style>


	<!-- Custom checkbox with a smooth fade-in check mark -->
	<Style Selector="CheckBox">
		<Setter Property="Foreground" Value="#5C5C5C"/>
		<Setter Property="BorderBrush" Value="#654321"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Grid Background="Transparent"
					  VerticalAlignment="Center"
					  ColumnDefinitions="Auto,*">

					<Border Name="PART_CheckBoxBorder"
							Width="18" Height="18"
							Margin="0 0 8 0"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="2"
							CornerRadius="6">
						<Canvas Width="18" Height="18">
							<Path Name="PART_CheckMark"
								  Opacity="0"
								  Data="M 4,9 L 8,13 L 14,5"
								  Stroke="#654321"
								  StrokeThickness="2">
								<Path.Transitions>
									<Transitions>
										<DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
										<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
									</Transitions>
								</Path.Transitions>
							</Path>
						</Canvas>
					</Border>

					<ContentPresenter Name="PART_ContentPresenter"
									  Grid.Column="1"
									  Content="{TemplateBinding Content}"/>
				</Grid>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Smooth foreground colour transition on the label -->
	<Style Selector="CheckBox ContentPresenter">
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Foreground" Duration="0:0:0.2"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Darken label on hover -->
	<Style Selector="CheckBox:pointerover ContentPresenter">
		<Setter Property="Foreground" Value="#343434"/>
	</Style>

	<!-- Restore default label colour when checked -->
	<Style Selector="CheckBox:checked">
		<Setter Property="Foreground" Value="#5C5C5C"/>
	</Style>

	<!-- Remove border thickness when the box is checked (check mark replaces it) -->
	<Style Selector="CheckBox:checked /template/ Border#PART_CheckBoxBorder">
		<Setter Property="BorderThickness" Value="0"/>
	</Style>

	<!-- Fade the check mark in when the box is checked -->
	<Style Selector="CheckBox:checked /template/ Path#PART_CheckMark">
		<Setter Property="Opacity" Value="1"/>
		<Setter Property="RenderTransform">
			<ScaleTransform ScaleX="1" ScaleY="1"/>
		</Setter>
	</Style>


	<!-- Minimalist scroll bar base — transparent track, narrow thumb -->
	<Style Selector="ScrollBar">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="MinWidth" Value="4"/>
	</Style>

	<!-- Standard vertical scroll bar with top/bottom margin for breathing room -->
	<Style Selector="ScrollBar:vertical">
		<Setter Property="Width" Value="4"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent"
						Margin="0 28">
					<Track IsDirectionReversed="True"
						   Maximum="{TemplateBinding Maximum}"
						   Minimum="{TemplateBinding Minimum}"
						   Orientation="Vertical"
						   ViewportSize="{TemplateBinding ViewportSize}"
						   Value="{TemplateBinding Value, Mode=TwoWay}">
						<Track.Thumb>
							<Thumb MinHeight="30">
								<Thumb.Template>
									<ControlTemplate>
										<Border Background="LightGray"
												CornerRadius="10"
												Opacity="0.6"/>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Track.Thumb>
					</Track>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>

	<!-- Variant without the default top/bottom margin — use inside compact containers -->
	<Style Selector="ScrollBar.NoBottomMargin:vertical">
		<Setter Property="Width" Value="4"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent"
						Padding="0"
						Margin="0">
					<Track IsDirectionReversed="True"
						   Maximum="{TemplateBinding Maximum}"
						   Minimum="{TemplateBinding Minimum}"
						   Orientation="Vertical"
						   ViewportSize="{TemplateBinding ViewportSize}"
						   Value="{TemplateBinding Value, Mode=TwoWay}">
						<Track.Thumb>
							<Thumb MinHeight="30">
								<Thumb.Template>
									<ControlTemplate>
										<Border Background="Gray"
												CornerRadius="10"
												Opacity="0.6"/>
									</ControlTemplate>
								</Thumb.Template>
							</Thumb>
						</Track.Thumb>
					</Track>
				</Border>
			</ControlTemplate>
		</Setter>
	</Style>


	<Style Selector="ContextMenu">
		<Setter Property="Background" Value="White"/>
		<Setter Property="CornerRadius" Value="40"/>
		<Setter Property="BorderBrush" Value="#6B6B6B"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.4" Easing="CubicEaseOut"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="ContextMenu:pointerover">
		<Setter Property="Background" Value="#FAFAFA"/>
	</Style>

	<!-- Compact, semi-bold menu item labels -->
	<Style Selector="MenuItem">
		<Setter Property="Foreground" Value="Gray"/>
		<Setter Property="FontSize" Value="10"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontFamily" Value="{DynamicResource Montserrat}"/>
		<Setter Property="Padding" Value="11 5"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Border Background="Transparent"
						Padding="{TemplateBinding Padding}">
					<ContentPresenter Content="{TemplateBinding Header}"
									  VerticalAlignment="Center"
									  HorizontalAlignment="Stretch"/>
				</Border>
			</ControlTemplate>
		</Setter>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Foreground" Duration="0:0:0.4" Easing="CubicEaseOut"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Slightly darken label on hover -->
	<Style Selector="MenuItem:pointerover">
		<Setter Property="Foreground" Value="#6B6B6B"/>
	</Style>


	<!-- Open-eye icon displayed when the password is hidden -->
	<Style Selector="Path.ReavealPasswordEyeIcon">
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Data" Value="M1,12C3.5,7.5 7.5,5 12,5C16.5,5 20.5,7.5 23,12C20.5,16.5 16.5,19 12,19C7.5,19 3.5,16.5 1,12Z
		M12,9A3,3 0 1 0 12,15A3,3 0 1 0 12,9Z"/>
		<Setter Property="Stroke" Value="#4E342E"/>
		<Setter Property="StrokeThickness" Value="1.8"/>
		<Setter Property="StrokeLineCap" Value="Round"/>
		<Setter Property="StrokeJoin" Value="Round"/>
		<Setter Property="Fill" Value="Transparent"/>
	</Style>

	<!-- Diagonal strike-through line overlaid on the eye icon when password is visible -->
	<Style Selector="Path.ReavealPasswordCrossIcon">
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Data" Value="M5,5L19,19"/>
		<Setter Property="Stroke" Value="#4E342E"/>
		<Setter Property="StrokeThickness" Value="1.8"/>
		<Setter Property="StrokeLineCap" Value="Round"/>
		<Setter Property="StrokeJoin" Value="Round"/>
		<Setter Property="Fill" Value="Transparent"/>
		<Setter Property="IsVisible" Value="False"/>
	</Style>


	<!-- Custom underline-only TextBox used in the Invitation Manager search bar -->
	<Style Selector="TextBox.InvitationSearch">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Foreground" Value="#383838"/>
		<Setter Property="BorderThickness" Value="0 0 0 1"/>
		<Setter Property="BorderBrush" Value="#9c9c91"/>
		<Setter Property="CaretBrush" Value="#2A2118"/>
		<Setter Property="Padding" Value="8 4"/>
		<Setter Property="CornerRadius" Value="0"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="LetterSpacing" Value="1.2"/>
		<Setter Property="FontFamily" Value="{DynamicResource Montserrat}"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Italic placeholder for the invitation search box -->
	<Style Selector="TextBox.InvitationSearch /template/ TextBlock#PART_Watermark">
		<Setter Property="Foreground" Value="#9c9c91"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontStyle" Value="Italic"/>
	</Style>

	<!-- Subtle opacity change on hover -->
	<Style Selector="TextBox.InvitationSearch:pointerover">
		<Setter Property="Foreground" Value="#383838"/>
		<Setter Property="Opacity" Value="0.95"/>
	</Style>

	<!-- Keep underline border on hover -->
	<Style Selector="TextBox.InvitationSearch:pointerover /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="#a39c91"/>
		<Setter Property="BorderThickness" Value="0 0 0 1"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Slightly stronger text and font weight on focus -->
	<Style Selector="TextBox.InvitationSearch:focus">
		<Setter Property="Foreground" Value="#2A2118"/>
		<Setter Property="Opacity" Value="1"/>
		<Setter Property="FontWeight" Value="Medium"/>
	</Style>

	<!-- Slightly thicker underline border on focus -->
	<Style Selector="TextBox.InvitationSearch:focus /template/ Border#PART_BorderElement">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="#2A2118"/>
		<Setter Property="BorderThickness" Value="0 0 0 1.2"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.25"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Darken placeholder on hover or focus -->
	<Style Selector="TextBox.InvitationSearch:pointerover /template/ TextBlock#PART_Watermark,
	TextBox.InvitationSearch:focus       /template/ TextBlock#PART_Watermark">
		<Setter Property="Foreground" Value="#3f352b"/>
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontStyle" Value="Italic"/>
	</Style>


	<!-- Muted semi-bold label used for each column header -->
	<Style Selector="TextBlock.InvitationColumnHeader">
		<Setter Property="Foreground" Value="#3f352b"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Opacity" Value="0.7"/>
	</Style>


	<!-- Full-width dark pill that serves as the row background for each invite -->
	<Style Selector="Border.InvitationRow">
		<Setter Property="Height" Value="40"/>
		<Setter Property="VerticalAlignment" Value="Stretch"/>
		<Setter Property="Background" Value="#4b4742"/>
		<Setter Property="CornerRadius" Value="18"/>
		<Setter Property="Margin" Value="0 4"/>
	</Style>


	<!-- Italic light text used in the Created date column -->
	<Style Selector="TextBlock.InvitationCreatedDate">
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Foreground" Value="#f5e8d8"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="FontStyle" Value="Italic"/>
	</Style>

	<!-- Italic light text used in the Expires date column -->
	<Style Selector="TextBlock.InvitationExpiresDate">
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Foreground" Value="#f5e8d8"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="FontStyle" Value="Italic"/>
	</Style>


	<!-- Compact pill shown in the Code column; expands on click -->
	<Style Selector="Border.InvitationCodeCollapsed">
		<Setter Property="Height" Value="24"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Background" Value="#f5e8d8"/>
		<Setter Property="CornerRadius" Value="12"/>
		<Setter Property="Padding" Value="8 4"/>
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Height" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
				<BrushTransition Property="Background" Duration="0:0:0.25"/>
				<DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseInOut"/>
				<CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Hand cursor and darker fill on hover -->
	<Style Selector="Border.InvitationCodeCollapsed:pointerover">
		<Setter Property="Background" Value="#aaa399"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<!-- "Click here to Expand" prompt label -->
	<Style Selector="TextBlock.InvitationCodeCollapsedLabel">
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Foreground" Value="#3f352b"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="Medium"/>
	</Style>


	<!-- Full-width pill that replaces the collapsed pill and shows the raw code -->
	<Style Selector="Border.InvitationCodeExpanded">
		<Setter Property="Height" Value="40"/>
		<Setter Property="Background" Value="#f5e8d8"/>
		<Setter Property="CornerRadius" Value="16"/>
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Height" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
				<BrushTransition Property="Background" Duration="0:0:0.25"/>
				<DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseInOut"/>
				<CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.5" Easing="CubicEaseInOut"/>
			</Transitions>
		</Setter>
	</Style>

	<!-- Hand cursor and darker fill on hover -->
	<Style Selector="Border.InvitationCodeExpanded:pointerover">
		<Setter Property="Background" Value="#aaa399"/>
		<Setter Property="Cursor" Value="Hand"/>
	</Style>

	<!-- Spaced-out code text rendered inside the expanded pill -->
	<Style Selector="TextBlock.InvitationCodeExpandedLabel">
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Foreground" Value="#3f352b"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="LetterSpacing" Value="4"/>
	</Style>


	<!-- Dim italic text showing who redeemed the invite (or "(not used)") -->
	<Style Selector="TextBlock.InvitationRedeemedBy">
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Foreground" Value="#f5e8d8"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontStyle" Value="Italic"/>
		<Setter Property="Opacity" Value="0.7"/>
	</Style>


	<!-- Shared text style for all status badge labels -->
	<Style Selector="TextBlock.InvitationStatusLabel">
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Foreground" Value="#383838"/>
		<Setter Property="FontSize" Value="12"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
	</Style>

	<!-- Green badge — invitation is still valid and unused -->
	<Style Selector="Border.InvitationStatusActive">
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Background" Value="#85a47d"/>
		<Setter Property="Padding" Value="8 4"/>
		<Setter Property="CornerRadius" Value="24"/>
	</Style>

	<!-- Amber badge — invitation has been redeemed -->
	<Style Selector="Border.InvitationStatusUsed">
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Background" Value="#c4b982"/>
		<Setter Property="Padding" Value="8 4"/>
		<Setter Property="CornerRadius" Value="24"/>
	</Style>

	<!-- Terracotta badge — invitation has passed its expiry date -->
	<Style Selector="Border.InvitationStatusExpired">
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Background" Value="#b88475"/>
		<Setter Property="Padding" Value="8 4"/>
		<Setter Property="CornerRadius" Value="24"/>
	</Style>

	<!-- Red badge — invitation was manually revoked -->
	<Style Selector="Border.InvitationStatusRevoked">
		<Setter Property="HorizontalAlignment" Value="Center"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Background" Value="#d31840"/>
		<Setter Property="Padding" Value="8 4"/>
		<Setter Property="CornerRadius" Value="24"/>
	</Style>


	<!-- Rounded bottom-sheet container for the activity log panel -->
	<Style Selector="Border.ActivityLogSheet">
		<Setter Property="Background"   Value="#FBF7F1"/>
		<Setter Property="CornerRadius" Value="20 20 0 0"/>
		<Setter Property="BoxShadow"    Value="0 -4 40 0 #30000000"/>
		<Setter Property="Padding"      Value="32 28 32 20"/>
	</Style>


	<!-- Inactive filter chip -->
	<Style Selector="Border.ActivityFilterChip">
		<Setter Property="CornerRadius" Value="20"/>
		<Setter Property="Padding"      Value="12 5"/>
		<Setter Property="Cursor"       Value="Hand"/>
		<Setter Property="Background"   Value="#EDE7DE"/>
	</Style>

	<!-- Active filter chip (dark fill) -->
	<Style Selector="Border.ActivityFilterChipActive">
		<Setter Property="CornerRadius" Value="20"/>
		<Setter Property="Padding"      Value="12 5"/>
		<Setter Property="Cursor"       Value="Hand"/>
		<Setter Property="Background"   Value="#8B6B4A"/>
	</Style>

	<!-- Label inside an inactive chip -->
	<Style Selector="TextBlock.ActivityFilterChipLabel">
		<Setter Property="FontSize"          Value="11"/>
		<Setter Property="FontWeight"        Value="SemiBold"/>
		<Setter Property="Foreground"        Value="#6D4C41"/>
		<Setter Property="LetterSpacing"     Value="0.4"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

	<!-- Label inside an active chip -->
	<Style Selector="TextBlock.ActivityFilterChipLabelActive">
		<Setter Property="FontSize"          Value="11"/>
		<Setter Property="FontWeight"        Value="SemiBold"/>
		<Setter Property="Foreground"        Value="#F5E1C5"/>
		<Setter Property="LetterSpacing"     Value="0.4"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>


	<!-- Column header label -->
	<Style Selector="TextBlock.ActivityTableHead">
		<Setter Property="FontSize"      Value="11"/>
		<Setter Property="FontWeight"    Value="SemiBold"/>
		<Setter Property="Foreground"    Value="#8B6B4A"/>
		<Setter Property="LetterSpacing" Value="0.8"/>
	</Style>

	<!-- Date cell in a log row -->
	<Style Selector="TextBlock.ActivityRowDate">
		<Setter Property="FontSize"          Value="12"/>
		<Setter Property="Foreground"        Value="#9E8572"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="FontStyle"         Value="Italic"/>
	</Style>

	<!-- Activity message cell in a log row -->
	<Style Selector="TextBlock.ActivityRowAction">
		<Setter Property="FontSize"          Value="13"/>
		<Setter Property="Foreground"        Value="#4A4238"/>
		<Setter Property="FontWeight"        Value="Medium"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
	</Style>

	<!-- Colour-coded type pill border -->
	<Style Selector="Border.ActivityTypePill">
		<Setter Property="CornerRadius"        Value="10"/>
		<Setter Property="Padding"             Value="9 3"/>
		<Setter Property="VerticalAlignment"   Value="Center"/>
		<Setter Property="HorizontalAlignment" Value="Left"/>
	</Style>

	<!-- Text inside the type pill -->
	<Style Selector="TextBlock.ActivityTypePillText">
		<Setter Property="FontSize"      Value="10"/>
		<Setter Property="FontWeight"    Value="SemiBold"/>
		<Setter Property="LetterSpacing" Value="0.5"/>
	</Style>

	<!-- Thin horizontal rule between log rows -->
	<Style Selector="Border.ActivityRowDivider">
		<Setter Property="Height"     Value="1"/>
		<Setter Property="Background" Value="#EDE7DE"/>
	</Style>


	<!-- Small round icon button (refresh / close) in the log header -->
	<Style Selector="Button.ActivityLogIconButton">
		<Setter Property="Width"        Value="32"/>
		<Setter Property="Height"       Value="32"/>
		<Setter Property="CornerRadius" Value="16"/>
		<Setter Property="Background"   Value="#EDE7DE"/>
		<Setter Property="Padding"      Value="0"/>
	</Style>

	<Style Selector="Button.ActivityLogIconButton:pointerover ContentPresenter">
		<Setter Property="Background" Value="#D4C9A8"/>
	</Style>

	<!-- Red notification badge overlaid on the refresh button -->
	<Style Selector="Border.ActivityLogRefreshBadge">
		<Setter Property="Background"         Value="#C62828"/>
		<Setter Property="CornerRadius"       Value="8"/>
		<Setter Property="Width"              Value="16"/>
		<Setter Property="Height"             Value="16"/>
		<Setter Property="HorizontalAlignment" Value="Right"/>
		<Setter Property="VerticalAlignment"  Value="Top"/>
		<Setter Property="Margin"             Value="0 -3 -3 0"/>
	</Style>

	<!-- Count text inside the refresh badge -->
	<Style Selector="TextBlock.ActivityLogRefreshBadgeText">
		<Setter Property="FontSize"             Value="9"/>
		<Setter Property="FontWeight"           Value="Bold"/>
		<Setter Property="Foreground"           Value="White"/>
		<Setter Property="HorizontalAlignment"  Value="Center"/>
		<Setter Property="VerticalAlignment"    Value="Center"/>
	</Style>


	<!-- Inactive page-number button -->
	<Style Selector="Button.ActivityPagerButton">
		<Setter Property="Width"        Value="30"/>
		<Setter Property="Height"       Value="30"/>
		<Setter Property="CornerRadius" Value="15"/>
		<Setter Property="Background"   Value="#EDE7DE"/>
		<Setter Property="Padding"      Value="0"/>
	</Style>

	<Style Selector="Button.ActivityPagerButton:pointerover ContentPresenter">
		<Setter Property="Background" Value="#D4C9A8"/>
	</Style>

	<!-- Active (current) page-number button -->
	<Style Selector="Button.ActivityPagerButtonActive">
		<Setter Property="Width"        Value="30"/>
		<Setter Property="Height"       Value="30"/>
		<Setter Property="CornerRadius" Value="15"/>
		<Setter Property="Background"   Value="#8B6B4A"/>
		<Setter Property="Padding"      Value="0"/>
	</Style>


	<!-- Transaction row container — highlights on hover -->
	<Style Selector="Border.TxRow">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Padding"    Value="20 16"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="Background" Duration="0:0:0.15"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="Border.TxRow:pointerover">
		<Setter Property="Background" Value="#00000015"/>
	</Style>

</Styles>
