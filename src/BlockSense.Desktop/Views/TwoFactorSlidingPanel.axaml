<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BlockSense.Desktop.TwoFactorSlidingPanel">

    <Panel Background="#FBF7F1">
		
		<!-- Top Window Panel -->
		<Border x:Name="DragBorder"
                Height="30"
				VerticalAlignment="Top"
				Background="Transparent"/>

        <StackPanel HorizontalAlignment="Center"
					Spacing="30"
					Margin="40">

			<!-- Header Section -->
			<!-- Icon and Title -->
			<StackPanel HorizontalAlignment="Center"
						Spacing="12">

					<Border Width="80"
							Height="80"
							Background="#F5E8D3"
							CornerRadius="40"
							Margin="0 0 0 20">

						<Viewbox Width="40"
								 Height="40">

							<Path Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
								  Fill="#8B6B4A"
								  Stretch="Uniform"/>

						</Viewbox>
					</Border>

					<!-- Title and Instructions Container with Overlay -->
					<Panel x:Name="InstructionsPanel"
						   Height="60">

						<!-- Normal Instructions (Default State) -->
						<StackPanel Width="500"
									HorizontalAlignment="Center"
									Spacing="6"
									Opacity="1">

							<TextBlock x:Name="TitleText"
									   Text="Enter Verification Code"
									   HorizontalAlignment="Center"
									   Foreground="#4A4238"
									   FontSize="26"
									   FontWeight="SemiBold"/>

							<TextBlock x:Name="SubtitleText"
									   Text="Please enter the 6-digit code from your authenticator app"
									   HorizontalAlignment="Center"
									   Foreground="#6D4C41"
									   TextAlignment="Center"
									   TextWrapping="Wrap"
									   FontSize="14"
									   Opacity="0.8"/>
						</StackPanel>

						<!-- Success State (Initially Hidden) -->
						<StackPanel x:Name="VerifiedStatePanel"
									Width="500"
									HorizontalAlignment="Center"
									Spacing="6"
									Opacity="0"
									IsVisible="False">

							<TextBlock Text="Successfully verified."
									   HorizontalAlignment="Center"
									   Foreground="#7BBA5D"
									   FontSize="26"
									   FontWeight="SemiBold"/>

							<TextBlock Text="Don't forget to download backup codes in Security section"
									   HorizontalAlignment="Center"
									   Foreground="#7BBA5D"
									   TextAlignment="Center"
									   TextWrapping="Wrap"
									   FontSize="14"
									   Opacity="0.9"/>
						</StackPanel>

						<!-- Error State (Initially Hidden) -->
						<StackPanel x:Name="ErrorStatePanel"
									Width="500"
									HorizontalAlignment="Center"
									Spacing="6"
									Opacity="0"
									IsVisible="False">

							<TextBlock Text="Invalid Code"
									   HorizontalAlignment="Center"
									   Foreground="#CC2D4D"
									   FontSize="26"
									   FontWeight="SemiBold"/>

							<TextBlock Text="The code you entered is incorrect. Please try again."
									   HorizontalAlignment="Center"
									   Foreground="#CC2D4D"
									   TextAlignment="Center"
									   TextWrapping="Wrap"
									   FontSize="14"
									   Opacity="0.9"/>
						</StackPanel>
					</Panel>
			</StackPanel>

			<!-- Code Input Section -->
			<Panel HorizontalAlignment="Center">
				
				<!-- Regular 6-digit code input -->
				<StackPanel x:Name="RegularCodePanel"
							HorizontalAlignment="Center"
							Orientation="Horizontal"
							Spacing="12">
					
					<!-- ... Digits will be added programmatically ... -->
	
				</StackPanel>
				
				<!-- Backup code input (initially hidden) -->
				<!-- Backup code format: XXXX-XXX -->
				<StackPanel x:Name="BackupCodePanel"
							HorizontalAlignment="Center"
							Orientation="Horizontal"
							Spacing="8"
							IsVisible="False">
					
					<StackPanel Orientation="Horizontal"
								Spacing="2">
						
						<!-- ... Digits will be added programmatically [First 4 Characters]... -->
	 
					</StackPanel>
					
					<!-- Separator between the Characters -->
					<TextBlock Classes="DigitSeparator"
							   Text="-"/>
					
					<StackPanel Orientation="Horizontal"
								Spacing="2">
						
						<!-- ... Digits will be added programmatically [Last 3 Characters]... -->
	 
					</StackPanel>
				</StackPanel>
			</Panel>

			<!-- Action Buttons -->
			<StackPanel HorizontalAlignment="Center"
						Orientation="Horizontal"
						Spacing="20">

				<Button
					x:Name="CancelCodeButton"
					Classes="DefaultWhite"
					Width="120"
					Height="40"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Background="#E5E4E2">

					<TextBlock Text="Cancel"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"
							   Foreground="#5D3F36"
							   FontWeight="Medium"/>
				</Button>

				<Button x:Name="VerifyCodeButton"
						Classes="DefaultDarkBrown"
						Width="120"
						Height="40"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsEnabled="False">

					<TextBlock Text="Verify"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"
							   Foreground="#E6C8A0"
							   FontWeight="Medium"/>

				</Button>
			</StackPanel>
		</StackPanel>
		
		<!-- Toggle Button for Backup Code -->
		<Button x:Name="BackUpToggleButton"
				Classes="BackupCodeToggle"
				HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				Margin="8">

			<TextBlock x:Name="BackupToggleText"
					   Text="verify using backup code"
					   Foreground="#8B6B4A"
					   FontSize="12"
					   FontWeight="Medium"
					   Opacity="0.7"/>
		</Button>
    </Panel>

</UserControl>
