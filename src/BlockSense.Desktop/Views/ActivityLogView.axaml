<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BlockSense.Desktop.ActivityLogView">

    <Panel Background="#CC1A0F0A">

        <Border Classes="ActivityLogSheet" Margin="0 60 0 0">

            <Grid RowDefinitions="Auto Auto Auto * Auto">

                <!-- Header -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto * Auto"
                      Margin="0 0 0 20">

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">

                        <Border Width="36" Height="36"
                                Background="#E6C8A0"
                                CornerRadius="18">
                            <Viewbox Width="18" Height="18">
                                <Path Data="M13 3C9.23 3 6.19 5.95 6 9.67L4.08 12.19C3.84 12.5 4.06 12.94 4.47 12.94H6V15.94C6 17.04 6.9 17.94 8 17.94H9V20.94H16V15.19L18.29 12.64C18.73 12.14 19 11.5 19 10.81V7C19 4.79 17.21 3 15 3H13M13 5H15C16.1 5 17 5.9 17 7V10.81C17 11.04 16.91 11.27 16.76 11.43L14 14.41V18.94H11V15.94H8V10.94H5.89L7.06 9.46C7.2 7.27 9.4 5 12 5H13Z"
                                      Fill="#8B6B4A" Stretch="Uniform"/>
                            </Viewbox>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Activity Log"
                                       Foreground="#28282B"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       LetterSpacing="0.4"/>
                            <TextBlock x:Name="LogCountTextBlock"
                                       Text="Loading…"
                                       Foreground="#9E8572"
                                       FontSize="11"
                                       FontStyle="Italic"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">

                        <Grid>
                            <Button x:Name="RefreshButton"
                                    Classes="ActivityLogIconButton"
                                    ToolTip.Tip="Check for newer entries">
                                <Viewbox Width="15" Height="15">
                                    <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                          Fill="#8B6B4A" Stretch="Uniform"/>
                                </Viewbox>
                            </Button>

                            <Border x:Name="RefreshBadge"
                                    Classes="ActivityLogRefreshBadge"
                                    IsVisible="False">
                                <TextBlock x:Name="RefreshBadgeText"
                                           Classes="ActivityLogRefreshBadgeText"
                                           Text="0"/>
                            </Border>
                        </Grid>

                        <Button x:Name="CloseActivityLogButton"
                                Classes="ActivityLogIconButton">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M4,4 L20,20 M20,4 L4,20"
                                      Stroke="#6D4C41"
                                      StrokeThickness="2.5"
                                      StrokeLineCap="Round"
                                      Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Filter chips -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0 0 0 16">
                    <Border x:Name="ChipAll"    Classes="ActivityFilterChipActive">
                        <TextBlock x:Name="ChipAllLabel"    Classes="ActivityFilterChipLabelActive" Text="All"/>
                    </Border>
                    <Border x:Name="ChipUser"   Classes="ActivityFilterChip">
                        <TextBlock x:Name="ChipUserLabel"   Classes="ActivityFilterChipLabel" Text="User"/>
                    </Border>
                    <Border x:Name="ChipSystem" Classes="ActivityFilterChip">
                        <TextBlock x:Name="ChipSystemLabel" Classes="ActivityFilterChipLabel" Text="System"/>
                    </Border>
                    <Border x:Name="ChipCron"   Classes="ActivityFilterChip">
                        <TextBlock x:Name="ChipCronLabel"   Classes="ActivityFilterChipLabel" Text="Cron"/>
                    </Border>
                </StackPanel>

                <!-- Column headers -->
                <StackPanel Grid.Row="2" Margin="0 0 0 4">
                    <Grid ColumnDefinitions="160 * 80" Margin="0 0 0 12">
                        <TextBlock Grid.Column="0" Classes="ActivityTableHead" Text="DATE"/>
                        <TextBlock Grid.Column="1" Classes="ActivityTableHead" Text="ACTIVITY" Margin="12 0 0 0"/>
                        <TextBlock Grid.Column="2" Classes="ActivityTableHead" Text="TYPE"/>
                    </Grid>
                </StackPanel>

                <!-- Rows -->
                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0 4 0 0">
                    <StackPanel x:Name="LogRowsPanel" Spacing="0"/>
                </ScrollViewer>

                <!-- Pager -->
                <Grid Grid.Row="4"
                      ColumnDefinitions="* Auto *"
                      Margin="0 14 0 4">

                    <TextBlock x:Name="PagerInfoTextBlock"
                               Grid.Column="0"
                               Text="Page 1 of 1"
                               Foreground="#9E8572"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6">

                        <Button x:Name="PrevPageButton" Classes="ActivityPagerButton" IsEnabled="False">
                            <Viewbox Width="12" Height="12">
                                <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                                      Fill="#6D4C41" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>

                        <StackPanel x:Name="PageNumbersPanel" Orientation="Horizontal" Spacing="4"/>

                        <Button x:Name="NextPageButton" Classes="ActivityPagerButton">
                            <Viewbox Width="12" Height="12">
                                <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                      Fill="#6D4C41" Stretch="Uniform"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="20 rows / page"
                               Foreground="#C0B09E"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

            </Grid>
        </Border>
    </Panel>

</UserControl>
