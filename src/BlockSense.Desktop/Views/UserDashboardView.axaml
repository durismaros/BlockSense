<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BlockSense.Desktop.UserDashboardView">

    <UserControl.Styles>

		<Style Selector="Border.card">
			<Setter Property="Background" Value="#FBF7F1"/>
			<Setter Property="CornerRadius" Value="14"/>
			<Setter Property="BoxShadow" Value="0 2 10 0 #15000000"/>
			<Setter Property="Padding" Value="22"/>
			<Setter Property="Margin" Value="14 14 18 14"/>
		</Style>

		<Style Selector="Border.deviceCard">
			<Setter Property="Background" Value="#F5F0E8"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="16"/>
			<Setter Property="Margin" Value="0 0 0 10"/>
			<Setter Property="BorderBrush" Value="#E6DDD1"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>

		<Style Selector="TextBlock.label">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Foreground" Value="#4F4F4F"/>
			<Setter Property="Margin" Value="0 6 0 4"/>
		</Style>

		<Style Selector="TextBlock.deviceLabel">
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Foreground" Value="#8B6B4A"/>
			<Setter Property="Opacity" Value="0.9"/>
		</Style>

		<Style Selector="TextBlock.value">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Normal"/>
			<Setter Property="Foreground" Value="#6D4C41"/>
			<Setter Property="Opacity" Value="0.8"/>
			<Setter Property="Margin" Value="0 0 0 12"/>
		</Style>

		<Style Selector="TextBlock.deviceValue">
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Foreground" Value="#4A4238"/>
			<Setter Property="Margin" Value="0 2 0 0"/>
		</Style>

		<Style Selector="Border.badge">
			<Setter Property="Background" Value="#D4B38C"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="10 5"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
			<Setter Property="Margin" Value="0 2 0 12"/>
		</Style>

		<Style Selector="TextBlock.badgeText">
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontWeight" Value="Medium"/>
			<Setter Property="Foreground" Value="#F5E1C5"/>
		</Style>

		<Style Selector="Border.status">
			<Setter Property="Width" Value="90"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="Background" Value="#D4B38C"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="8 4"/>
		</Style>

		<Style Selector="Border.SecurityChecked">
			<Setter Property="Width" Value="20"/>
			<Setter Property="Height" Value="10"/>
			<Setter Property="Background" Value="#8B6B4A"/>
			<Setter Property="CornerRadius" Value="4"/>
		</Style>

		<Style Selector="Border.SecurityUnchecked">
			<Setter Property="Width" Value="20"/>
			<Setter Property="Height" Value="10"/>
			<Setter Property="Background" Value="#E6DDD1"/>
			<Setter Property="CornerRadius" Value="4"/>
		</Style>

		<Style Selector="Separator">
			<Setter Property="Height" Value="1"/>
			<Setter Property="Background" Value="#E6DDD1"/>
			<Setter Property="CornerRadius" Value="100"/>
			<Setter Property="Margin" Value="0 12"/>
		</Style>

		<Style Selector="Button.ConfirmDisable">
			<Setter Property="Background" Value="#E57373"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="CornerRadius" Value="20"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>

		<Style Selector="Button.ConfirmDisable:pointerover ContentPresenter, Button.ConfirmDisable:pressed ContentPresenter">
			<Setter Property="Background" Value="#DE4040"/>
			<Setter Property="Opacity" Value="1"/>
		</Style>
		
	</UserControl.Styles>

	<StackPanel>

			<!-- Enhanced Top Bar -->
			<Border Background="Transparent"
					Margin="20 30 20 15">
				<Panel>

					<!-- Back Navigation -->
					<Button x:Name="HomeButton"
							Classes="DefaultWhite"
							Width="44"
							Height="44"
							CornerRadius="22"
							HorizontalAlignment="Left">
						<Button.Styles>
							<Style Selector="Button:pointerover ContentPresenter, Button:pressed ContentPresenter">
								<Setter Property="Background" Value="#F5F0E8"/>
							</Style>
						</Button.Styles>
						<Viewbox Width="20"
								 Height="20"
								 HorizontalAlignment="Center"
								 VerticalAlignment="Center">
							<Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
								  Fill="#8B6B4A"
								  Stretch="Uniform"/>
						</Viewbox>
					</Button>

					<!-- Header Content -->
					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Spacing="12">

						<!-- User Icon -->
						<Border Width="36"
								Height="36"
								Background="#E6C8A0"
								CornerRadius="18">
							<Viewbox Width="20"
									 Height="20"
									 HorizontalAlignment="Center"
									 VerticalAlignment="Center">
								<Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
									  Fill="#8B6B4A"
									  Stretch="Uniform"/>
							</Viewbox>
						</Border>

						<!-- Title and Subtitle -->
						<StackPanel>
							<TextBlock Text="User Profile"
									   Foreground="#4A3C30"
									   LetterSpacing="0.6"
									   FontSize="22"
									   FontWeight="SemiBold"/>
							<TextBlock Text="Manage your account settings"
									   Foreground="#553B2A"
									   LetterSpacing="0.4"
									   FontSize="12"
									   FontWeight="Normal"
									   FontStyle="Italic"
									   Opacity="0.8"/>
						</StackPanel>
					</StackPanel>
				</Panel>
			</Border>


			<!-- Content Area -->
			<ScrollViewer Height="380"
						  Margin="10 0">
				<Grid ColumnDefinitions="350,*" RowDefinitions="Auto,*">

					<!-- User Data Card -->
					<Border Classes="card"
							Grid.Column="0" Grid.Row="0">
						<StackPanel>

							<Grid ColumnDefinitions="Auto,*">
								<!-- Profile Picture -->
								<Border Grid.Column="0"
										Width="80"
                                        Height="80"
                                        Background="#F3F4F6"
                                        CornerRadius="40"
                                        Cursor="Hand"
                                        ClipToBounds="True">
									<Border.Clip>
										<EllipseGeometry RadiusX="40" RadiusY="40" Center="40,40"/>
									</Border.Clip>

									<Border.ContextMenu>
										<ContextMenu>
											<MenuItem Header="Set Default"/>
										</ContextMenu>
									</Border.ContextMenu>

									<Image Name="ProfilePictureImage"
                                           Source="\Assets\Images\img_profile_default.png"
                                           Stretch="UniformToFill"/>
								</Border>

								<StackPanel Grid.Column="1" Margin="15 0 0 0" VerticalAlignment="Center">
									<TextBlock Name="UsernameTextBlock" Text="Username" FontSize="18" FontWeight="SemiBold" Foreground="#333333"/>
									<TextBlock Classes="value" Name="EmailTextBlock" Text="email@example.com" Margin="0 6 0 0"/>
								</StackPanel>
							</Grid>

							<Separator Margin="0 20"/>

							<!--User Id-->
							<TextBlock Classes="label" Text="User ID"/>
							<TextBlock Classes="value" Name="UidTextBlock"/>

							<!--User type (badges)-->
							<TextBlock Classes="label" Text="Account Badges"/>
							<StackPanel Name="AccountBadgesPanel" Orientation="Horizontal"
										Spacing="10"/>

							<!--User account creation date-->
							<TextBlock Classes="label" Text="Creation Date"/>
							<TextBlock Classes="value" Name="CreationDateTextBlock"/>

							<!--User invitiation user-->
							<TextBlock Classes="label" Text="Invited By"/>
							<TextBlock Classes="value" Name="InvitationUserTextBlock" FontStyle="Italic"/>

							<Button
								Classes="DefaultLightBrown"
								Width="200"
								Height="38"
								Margin="0 18 0 18"
								Padding="15 10"
								CornerRadius="12">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
									<Viewbox Width="16" Height="16" Margin="0 0 8 0" VerticalAlignment="Center">
										<Path Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
											  Fill="#8B6B4A" Stretch="Uniform"/>
									</Viewbox>
									<TextBlock
										  Text="Invite Manager"
										  VerticalAlignment="Center"
										  FontWeight="Medium"
										  Foreground="#8B6B4A"/>
								</StackPanel>
							</Button>
						</StackPanel>
					</Border>

					<!-- Wallet Statistics card -->
					<Border Classes="card" Grid.Column="1" Grid.Row="0" Name="WalletStatisticsCard">
						<StackPanel>

							<!--Header-->
							<Panel >
								<TextBlock Text="Wallet &amp; Security"
										   FontSize="20" FontWeight="SemiBold" Foreground="#333333"/>
								<TextBlock Name="LastUpdateTextBlock" Text="Updated: "
										   FontSize="12" Opacity="0.7" Foreground="#6D4C41"
										   FontStyle="Italic"
										   HorizontalAlignment="Right" VerticalAlignment="Center"/>
							</Panel>

							<Separator Margin="0 15"/>

							<!--Users account security level-->
							<TextBlock Classes="label" Text="Security Level"/>
							<StackPanel Name="SecurityLevelPanel" Orientation="Horizontal"
										Margin="0 5 0 15" Spacing="6">
								<Border Classes="SecurityChecked"/>
								<Border Classes="SecurityChecked"/>
								<Border Classes="SecurityChecked"/>
								<Border Classes="SecurityChecked"/>
								<Border Classes="SecurityChecked"/>
								<TextBlock Name="SecurityLevelTextBlock" Text="Perfect" Foreground="#6D4C41" FontSize="14" Margin="10 0 0 0"/>
							</StackPanel>

							<!--Users 2fa status (enabled/disabled)-->
							<TextBlock Classes="label" Text="2FA Status"/>
							<TextBlock Classes="value" Name="TwoFactorAuthTextBlock"/>

							<!--Active devices-->
							<TextBlock Classes="label" Text="Active Devices"/>
							<TextBlock Classes="value" Name="ActiveDevicesTextBlock"/>

							<!--Num of invited users-->
							<TextBlock Classes="label" Text="Total Invited Users"/>
							<TextBlock Classes="value" Name="UsersInvitedTextBlock"/>

							<Button
								Classes="DefaultDarkBrown"
								Width="240"
								Height="40"
								Margin="0 30 0 0"
								Padding="15 10"
								CornerRadius="12">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
									<Viewbox Width="16" Height="16" Margin="0 0 8 0" VerticalAlignment="Center">
										<Path Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
											  Fill="#E6C8A0" Stretch="Uniform"/>
									</Viewbox>
									<TextBlock
										Text="Manage Security Settings"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontWeight="Medium"
										Foreground="#E6C8A0"/>
								</StackPanel>
							</Button>

							<Button
								Classes="DefaultLightBrown"
								Width="220"
								Height="38"
								Margin="0 17 0 0"
								Padding="15 10"
								CornerRadius="12">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
									<Viewbox Width="16" Height="16" Margin="0 0 8 0" VerticalAlignment="Center">
										<Path Data="M17,3A2,2 0 0,1 19,5V15A2,2 0 0,1 17,17H13V19A1,1 0 0,0 14,20H20V22H14A3,3 0 0,1 11,19V17H7C5.89,17 5,16.1 5,15V5A2,2 0 0,1 7,3H17M17,5H7V15H17V5Z"
											  Fill="#8B6B4A" Stretch="Uniform"/>
									</Viewbox>
									<TextBlock
										Text="Manage Active Devices"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										FontWeight="Medium"
										Foreground="#8B6B4A"/>
								</StackPanel>
							</Button>

						</StackPanel>
					</Border>

					<!-- Security Manager Card -->
					<Border Classes="card" Name="SecurityManager" Grid.Column="1" Grid.Row="0"
							IsVisible="False" ZIndex="10">
						<StackPanel>

							<!-- Header -->
							<Panel>
								<StackPanel Orientation="Horizontal" Spacing="10">
									<Border Background="#E6C8A0" Width="28" Height="28" CornerRadius="14">
										<Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
											<Path Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
												  Fill="#8B6B4A" Stretch="Uniform"/>
										</Viewbox>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="Security Manager" Foreground="#4A4238" FontSize="18" FontWeight="SemiBold"/>
										<TextBlock Text="Manage security settings" Foreground="#6D4C41" FontSize="10" FontStyle="Italic" Opacity="0.8" Margin="0 1 0 0"/>
									</StackPanel>
								</StackPanel>

								<Button Classes="DefaultWhite" Width="28" Height="28" Background="Transparent" HorizontalAlignment="Right">
									<Viewbox Width="24" Height="24" Stretch="Uniform">
										<Canvas Width="24" Height="24">
											<Path Margin="0 1 0 0" Data="M18.3,5.71L18.3,5.71C18.69,5.32 18.69,4.69 18.3,4.3C17.91,3.91 17.28,3.91 16.89,4.3L12,9.19L7.11,4.3C6.72,3.91 6.09,3.91 5.7,4.3C5.31,4.69 5.31,5.32 5.7,5.71L10.59,10.6L5.7,15.49C5.31,15.88 5.31,16.51 5.7,16.9C5.9,17.09 6.16,17.19 6.42,17.19C6.68,17.19 6.95,17.09 7.14,16.9L12,12.01L16.89,16.9C17.09,17.09 17.35,17.19 17.61,17.19C17.87,17.19 18.13,17.09 18.33,16.9C18.72,16.51 18.72,15.88 18.33,15.49L13.44,10.6L18.3,5.71Z" Fill="#6D4C41" Opacity="0.7"/>
										</Canvas>
									</Viewbox>
								</Button>
							</Panel>

							<Separator/>


							<!-- Two-Factor Authentication Section -->

							<Border
								BorderBrush="#E6DDD1" BorderThickness="1"
								CornerRadius="12" Padding="15">
								<StackPanel>

									<!-- 2FA Disabled Content -->
									<StackPanel Name="TwoFaDisabledContent">
										<TextBlock
											Text="2FA is currently disabled. Enable it to increase your account security."
											Foreground="#6D4C41"
											FontSize="13"
											FontWeight="Medium"
											TextAlignment="Center"
											LineHeight="18"
											Opacity="0.9"
											Margin="0 0 0 10"
											TextWrapping="Wrap"/>

										<!-- QR Code and Setup Info -->
										<Grid>
											<!-- QR Code Container -->
											<StackPanel HorizontalAlignment="Center" Margin="0 5 0 10">
												<Border
													Width="200"
													Height="200"
													Background="White"
													BorderBrush="#E6DDD1"
													BorderThickness="1"
													CornerRadius="12"
													HorizontalAlignment="Center"
													Margin="0 0 0 10">
													<Image
														Name="QRCodeImage"
														Width="190"
														Height="190"
														Stretch="UniformToFill"
														HorizontalAlignment="Center"
														VerticalAlignment="Center"/>
												</Border>

												<TextBlock
													Text="Scan with authenticator app"
													FontSize="12"
													Foreground="#8B6B4A"
													HorizontalAlignment="Center"/>
											</StackPanel>
										</Grid>

										<!-- Setup Key -->
										<StackPanel Margin="0 10 0 0">
											<TextBlock
												Text="Setup Key"
												FontWeight="Medium"
												Foreground="#4A4238"
												Margin="0 0 0 5"
												HorizontalAlignment="Center"/>

											<Border
												Width="300"
												Background="#F5F0E8"
												Padding="12"
												CornerRadius="8"
												HorizontalAlignment="Center">

												<Viewbox Stretch="Uniform" StretchDirection="DownOnly">
													<TextBlock
														Name="SetupKeyText"
														FontSize="11"
														FontStyle="Italic"
														Foreground="#6D4C41"
														HorizontalAlignment="Center"
														TextAlignment="Center"
														LetterSpacing="1"/>
												</Viewbox>
											</Border>

										</StackPanel>

										<!-- Enable Button -->
										<Border
											Name="EnableTwoFaButton"
											Classes="DefaultDarkBrown"
											Width="140"
											Height="36"
											HorizontalAlignment="Center"
											Margin="0 15 0 0"
											Cursor="Hand">
											<TextBlock
												Text="Enable 2FA"
												FontWeight="Medium"
												Foreground="#E6C8A0"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"/>
										</Border>
									</StackPanel>

									<!-- 2FA Enabled Content -->
									<StackPanel Name="TwoFaEnabledContent" IsVisible="False">
										<TextBlock
											Text="Two-Factor Authentication is enabled"
											FontSize="16"
											FontWeight="Medium"
											Foreground="#4CAF50"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Margin="0 0 0 15"/>

										<TextBlock
											Text="Your account is protected with 2FA. You'll need to provide a 6-digit verification code from your authenticator app when logging in."
											Foreground="#6D4C41"
											FontSize="13"
											FontWeight="Medium"
											FontStyle="Italic"
											TextAlignment="Center"
											LineHeight="18"
											Opacity="0.9"
											Margin="0 15 0 20"
											TextWrapping="Wrap"/>

										<!-- 2FA Management Options -->
										<StackPanel Spacing="15" Margin="0 20 0 0">
											<Border
												Background="#F5F0E8"
												CornerRadius="12"
												Padding="15">
												<StackPanel Spacing="8">
													<StackPanel Orientation="Horizontal" Spacing="10">
														<Viewbox Width="16" Height="16" VerticalAlignment="Center">
															<Path Data="M12 1L3 5V11C3 16.55 6.84 21.74 12 23C17.16 21.74 21 16.55 21 11V5L12 1M12 7C13.4 7 14.8 8.6 14.8 10.1V11.1C15.4 11.1 16 11.4 16 12V16C16 16.6 15.6 17 15 17H9C8.4 17 8 16.6 8 16V12C8 11.4 8.4 11 9 11H9.2V10.1C9.2 8.6 10.6 7 12 7M12 8.2C11.2 8.2 10.5 8.7 10.5 10.1V11.1H13.6V10.1C13.6 8.7 12.9 8.2 12 8.2Z"
																  Fill="#8B6B4A" Stretch="Uniform"/>
														</Viewbox>
														<TextBlock
															Text="Backup Codes"
															FontSize="14"
															FontWeight="Medium"
															Foreground="#4A4238"/>
													</StackPanel>
													<TextBlock
														Name="BackupCodesTextBlock"
														Text="Save backup codes to access your account if you lose access to your device"
														FontSize="12"
														Foreground="#6D4C41"
														Opacity="0.8"
														TextWrapping="Wrap"/>
													<Panel>
														<Button
															Classes="DefaultDarkBrown"
															Width="120"
															Height="32"
															HorizontalAlignment="Left">
															<TextBlock
																Text="Generate Codes"
																FontSize="12"
																FontWeight="Medium"
																Foreground="#E6C8A0"
																HorizontalAlignment="Center"
																VerticalAlignment="Center"/>
														</Button>

														<Button
															Name="BackupCodesDownloadButton"
															Classes="DefaultLightBrown"
															Width="160"
															Height="32"
															HorizontalAlignment="Right"
															IsVisible="False">
															<TextBlock
																Text="Download *.txt file"
																FontSize="12"
																FontWeight="Medium"
																Foreground="#5D3F36"
																HorizontalAlignment="Center"
																VerticalAlignment="Center"/>
														</Button>
													</Panel>
												</StackPanel>
											</Border>

											<Border
												Background="#FFF3E0"
												BorderBrush="#FFB74D"
												BorderThickness="1"
												CornerRadius="12"
												Padding="15">
												<StackPanel Spacing="8">
													<StackPanel Orientation="Horizontal" Spacing="10">
														<Viewbox Width="16" Height="16" VerticalAlignment="Center">
															<Path Data="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"
																  Fill="#FF9800" Stretch="Uniform"/>
														</Viewbox>
														<TextBlock
															Text="Disable 2FA"
															FontSize="14"
															FontWeight="Medium"
															Foreground="#E65100"/>
													</StackPanel>
													<TextBlock
														Text="Disabling 2FA will reduce your account security level"
														FontSize="12"
														Foreground="#BF360C"
														Opacity="0.9"
														TextWrapping="Wrap"/>
													<Panel>
														<Button
															Classes="DefaultDisable"
															Width="120"
															Height="32"
															HorizontalAlignment="Left">
															<TextBlock
																Text="Disable"
																FontSize="12"
																FontWeight="Medium"
																Foreground="#E57373"
																HorizontalAlignment="Center"
																VerticalAlignment="Center"/>
														</Button>

														<Button
															Name="DisableTwoFaButton"
															Classes="ConfirmDisable"
															Width="160"
															Height="32"
															HorizontalAlignment="Right"
															IsVisible="False">
															<TextBlock
																Text="Confirm"
																FontSize="12"
																FontWeight="Medium"
																Foreground="#F5E1DA"
																HorizontalAlignment="Center"
																VerticalAlignment="Center"/>
														</Button>
													</Panel>
												</StackPanel>
											</Border>
										</StackPanel>
									</StackPanel>

								</StackPanel>
							</Border>
						</StackPanel>
					</Border>

					<!-- Device Manager Card -->
					<Border Classes="card" Name="DeviceManager" Grid.Column="1" Grid.Row="0"
							IsVisible="False" ZIndex="10">
						<StackPanel>

							<Panel>
								<StackPanel Orientation="Horizontal" Spacing="10">
									<Border Background="#E6C8A0" Width="28" Height="28" CornerRadius="14">
										<Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
											<Path Data="M17,3A2,2 0 0,1 19,5V15A2,2 0 0,1 17,17H13V19A1,1 0 0,0 14,20H20V22H14A3,3 0 0,1 11,19V17H7C5.89,17 5,16.1 5,15V5A2,2 0 0,1 7,3H17M17,5H7V15H17V5Z"
												  Fill="#8B6B4A" Stretch="Uniform"/>
										</Viewbox>
									</Border>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="Device Manager" Foreground="#4A4238" FontSize="18" FontWeight="SemiBold"/>
										<TextBlock Text="Manage active sessions" Foreground="#6D4C41" FontSize="10" FontStyle="Italic" Opacity="0.8" Margin="0 1 0 0"/>
									</StackPanel>
								</StackPanel>

								<Button Classes="DefaultWhite" Width="28" Height="28" Background="Transparent" HorizontalAlignment="Right">
									<Viewbox Width="24" Height="24" Stretch="Uniform">
										<Canvas Width="24" Height="24">
											<Path Margin="0 1 0 0" Data="M18.3,5.71L18.3,5.71C18.69,5.32 18.69,4.69 18.3,4.3C17.91,3.91 17.28,3.91 16.89,4.3L12,9.19L7.11,4.3C6.72,3.91 6.09,3.91 5.7,4.3C5.31,4.69 5.31,5.32 5.7,5.71L10.59,10.6L5.7,15.49C5.31,15.88 5.31,16.51 5.7,16.9C5.9,17.09 6.16,17.19 6.42,17.19C6.68,17.19 6.95,17.09 7.14,16.9L12,12.01L16.89,16.9C17.09,17.09 17.35,17.19 17.61,17.19C17.87,17.19 18.13,17.09 18.33,16.9C18.72,16.51 18.72,15.88 18.33,15.49L13.44,10.6L18.3,5.71Z" Fill="#6D4C41" Opacity="0.7"/>
										</Canvas>
									</Viewbox>
								</Button>
							</Panel>

							<Separator/>

							<ScrollViewer MaxHeight="320">
								<StackPanel Name="DevicesPanel" Spacing="0">

									<!-- Example Device Cards -->
									<Border Classes="deviceCard">
										<Grid ColumnDefinitions="*,Auto">
											<StackPanel Grid.Column="0" Spacing="10">
												<StackPanel>
													<TextBlock Classes="deviceLabel" Text="IP Address"/>
													<TextBlock Classes="deviceValue" Text="85.237.227.*"/>
												</StackPanel>
												<Grid ColumnDefinitions="*,*">
													<StackPanel Grid.Column="0">
														<TextBlock Classes="deviceLabel" Text="Issued At"/>
														<TextBlock Classes="deviceValue" Text="Sep 05, 2025"/>
													</StackPanel>
													<StackPanel Grid.Column="1">
														<TextBlock Classes="deviceLabel" Text="Expires At"/>
														<TextBlock Classes="deviceValue" Text="Sep 08, 2025"/>
													</StackPanel>
												</Grid>
											</StackPanel>
											<Button Grid.Column="1" Classes="DefaultDisable" 
													Width="100" Height="30"
													VerticalAlignment="Center">
												<TextBlock Text="Revoke" FontSize="12" FontWeight="Medium" Foreground="#E57373" HorizontalAlignment="Center" VerticalAlignment="Center"/>
											</Button>
										</Grid>
									</Border>

								</StackPanel>
							</ScrollViewer>

							<Button Classes="DefaultDarkBrown" Width="240" Height="38" Margin="0 20 0 0" HorizontalAlignment="Center">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
									<Viewbox Width="15" Height="15" VerticalAlignment="Center">
										<Path Data="M14.08,15.59L16.67,13H7V11H16.67L14.08,8.41L15.5,7L20.5,12L15.5,17L14.08,15.59M19,3A2,2 0 0,1 21,5V9.67L19,7.67V5H5V19H19V16.33L21,14.33V19A2,2 0 0,1 19,21H5C3.89,21 3,20.1 3,19V5C3,3.89 3.89,3 5,3H19Z" Fill="#E6C8A0" Stretch="Uniform"/>
									</Viewbox>
									<TextBlock Text="Log Out All Known Devices" FontSize="12" FontWeight="Medium" Foreground="#E6C8A0" VerticalAlignment="Center"/>
								</StackPanel>
							</Button>

						</StackPanel>
					</Border>

					<!-- Activity Log Card-->
					<Border Classes="card" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
						<StackPanel>

							<!-- Header -->
							<TextBlock
								Text="Recent Activity"
								Foreground="#4A4238"
								FontSize="18"
								FontWeight="Medium"
								Margin="0 0 0 10"/>

							<!-- Table definition -->
							<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" Margin="0 10">
								<!-- Columns -->
								<TextBlock Grid.Row="0" Grid.Column="0" Text="Date" FontWeight="SemiBold" Foreground="#8B6B4A"/>
								<TextBlock Grid.Row="0" Grid.Column="1" Text="Activity" FontWeight="SemiBold" Foreground="#8B6B4A"/>
								<TextBlock Grid.Row="0" Grid.Column="2" Text="Status" FontWeight="SemiBold" Foreground="#8B6B4A"/>

								<Separator Grid.Row="1" Grid.ColumnSpan="3" Margin="0 10"/>

								<!-- Row 1 -->
								<TextBlock Grid.Row="2" Grid.Column="0" Text="Apr 15, 2025" Foreground="#5D4B35" Margin="0 0 20 0"/>
								<TextBlock Grid.Row="2" Grid.Column="1" Text="Password Changed" Foreground="#5D4B35"/>
								<Border Grid.Row="2" Grid.Column="2" Classes="status">
									<TextBlock Text="Completed" Height="16" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
								</Border>

								<!-- Row 2 -->
								<TextBlock Grid.Row="3" Grid.Column="0" Text="Apr 12, 2025" Foreground="#5D4B35" Margin="0 15 20 0"/>
								<TextBlock Grid.Row="3" Grid.Column="1" Text="New Device Login" Foreground="#5D4B35" Margin="0 15 0 0"/>
								<Border Grid.Row="3" Grid.Column="2" Classes="status" Margin="0 15 0 0">
									<TextBlock Text="Verified" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
								</Border>

								<!-- Row 3 -->
								<TextBlock Grid.Row="4" Grid.Column="0" Text="Apr 10, 2025" Foreground="#5D4B35" Margin="0 15 20 0"/>
								<TextBlock Grid.Row="4" Grid.Column="1" Text="Wallet Backup" Foreground="#5D4B35" Margin="0 15 0 0"/>
								<Border Grid.Row="4" Grid.Column="2" Classes="status" Margin="0 15 0 0">
									<TextBlock Text="Completed" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
								</Border>
							</Grid>

							<!-- Full Activity Log Button -->
							<Button
								Width="200"
								Height="40"
								Background="Transparent"
								HorizontalAlignment="Center"
								Margin="0 14 0 0"
								Padding="15 10"
								BorderBrush="#6D4C41"
								BorderThickness="1"
								CornerRadius="8">

								<TextBlock
									Text="View Full Activity Log"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontWeight="Medium"
									Foreground="#5D3F36"/>

								<Button.Styles>
									<Style Selector="Button:pointerover ContentPresenter">
										<Setter Property="Background" Value="Transparent" />
										<Setter Property="BorderBrush" Value="#6D4C41"/>
									</Style>
								</Button.Styles>
							</Button>

						</StackPanel>
					</Border>
				</Grid>
			</ScrollViewer>
		</StackPanel>


</UserControl>
