<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="BlockSense.Desktop.WalletSelectionView">

	<UserControl.Styles>
		<Style Selector="Button.WalletSelectionButton">
			<Setter Property="Width" Value="120"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Background" Value="#E8E2DA"/>
			<Setter Property="CornerRadius" Value="20"/>
		</Style>

		<Style Selector="Button.WalletSelectionButton:pointerover ContentPresenter, Button.WalletSelectionButton:pressed ContentPresenter">
			<Setter Property="Background" Value="#D1CBC4"/>
		</Style>
	</UserControl.Styles>

	<Panel>

		<!-- Go Back Button -->
		<Button x:Name="HomeButton"
				Width="44"
				Height="44"
				HorizontalAlignment="Left"
				VerticalAlignment="Top"
				Background="Transparent"
				CornerRadius="22"
				Margin="16 32 0 0">

			<Viewbox Width="20"
					 Height="20"
					 HorizontalAlignment="Center"
					 VerticalAlignment="Center">
				<Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
					  Fill="#28282B"
					  Stretch="Uniform"/>
			</Viewbox>

			<Button.Styles>
				<Style Selector="Button:pointerover ContentPresenter, Button:pressed ContentPresenter">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="RenderTransform" Value="scale(1.1)" />
				</Style>
			</Button.Styles>
		</Button>

		<!-- Options Section -->
		<StackPanel HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Orientation="Horizontal"
					Spacing="32">

			<!-- Create New Wallet Option -->
			<Button x:Name="CreateWalletButton"
					Classes="WalletSelectionButton"
					Width="340"
					Height="240"
					VerticalAlignment="Center">

				<StackPanel Spacing="4"
							HorizontalAlignment="Center">

					<!-- Icon: Sparkle/New -->
					<Canvas Width="64" Height="64">
						<Path Data="M32 8 L35 18 L45 20 L35 22 L32 32 L29 22 L19 20 L29 18 Z"
							  Fill="#8B6F47"/>
						<Path Data="M48 28 L50 34 L56 36 L50 38 L48 44 L46 38 L40 36 L46 34 Z"
							  Fill="#8B6F47"/>
						<Path Data="M16 40 L18 46 L24 48 L18 50 L16 56 L14 50 L8 48 L14 46 Z"
							  Fill="#8B6F47"/>
					</Canvas>

					<TextBlock HorizontalAlignment="Center"
							   Text="Create New Wallet"
							   Foreground="#3E2F23"
							   FontSize="18"
							   FontWeight="SemiBold"
							   Margin="0 8 0 0"/>

					<TextBlock HorizontalAlignment="Center"
							   Text="Start fresh with a new wallet and secure seed phrase"
							   Foreground="#8B7355"
							   FontSize="14"
							   TextWrapping="Wrap"
							   TextAlignment="Center"
							   LineHeight="20"
							   MaxWidth="300"/>
				</StackPanel>
			</Button>

			<!-- Import Existing Wallet Option -->
			<Button x:Name="ImportWalletButton"
					Classes="WalletSelectionButton"
					Width="340"
					Height="240"
					VerticalAlignment="Bottom">

				<StackPanel Spacing="4"
							HorizontalAlignment="Center">

					<!-- Icon: Download/Import -->
					<Canvas Width="64" Height="64">
						<Path Data="M32 10 L32 42 M32 42 L22 32 M32 42 L42 32"
							  Stroke="#8B6F47"
							  StrokeThickness="3"
							  StrokeLineCap="Round"/>

						<Path Data="M16 48 L16 52 C16 54 18 56 20 56 L44 56 C46 56 48 54 48 52 L48 48"
							  Stroke="#8B6F47"
							  StrokeThickness="3"
							  StrokeLineCap="Round"/>
					</Canvas>

					<TextBlock HorizontalAlignment="Center"
							   Text="Import Existing Wallet"
							   Foreground="#3E2F23"
							   FontSize="18"
							   FontWeight="SemiBold"
							   Margin="0 8 0 0"/>

					<TextBlock HorizontalAlignment="Center"
							   Text="Restore your wallet using a recovery seed phrase"
							   Foreground="#8B7355"
							   FontSize="14"
							   TextWrapping="Wrap"
							   TextAlignment="Center"
							   LineHeight="20"
							   MaxWidth="300"/>
				</StackPanel>
			</Button>
		</StackPanel>

		<!-- Header Section -->
		<TextBlock HorizontalAlignment="Center"
				   VerticalAlignment="Bottom"
				   Text="Choose how you'd like to get started with your digital wallet"
				   Foreground="#2E1812"
				   FontSize="14"
				   FontStyle="Italic"
				   Margin="24"/>
	</Panel>

</UserControl>
