<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BlockSense.Desktop.InvitationManagerWindow"
        Title="InvitationManager"
        Width="600" Height="350"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ShowInTaskbar="False">

    <Border Width="600"
            Height="350"
            Background="#F5E9D8"
            CornerRadius="24"
            Opacity="0.95">

        <StackPanel>

            <!-- Drag area / window title bar -->
            <Border x:Name="DraggableArea"
                    Height="28"
                    VerticalAlignment="Top"
                    Background="#E7CAA2"
                    CornerRadius="24 0"
                    Opacity="0.8">
                <Panel>

                    <TextBlock Text="Invitation Manager"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#3b342a"
                               FontWeight="SemiBold"
                               FontStyle="Italic"/>

                    <Button x:Name="CloseWindowButton"
                            Classes="MacOsCloseButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0 0 14 0"/>
                </Panel>
            </Border>

            <!-- Main content -->
            <StackPanel Margin="12">

                <!-- Search bar -->
                <TextBox x:Name="InvitationSearchTextBox"
                         Classes="InvitationSearch"
                         Watermark="Search invites..."
                         Height="32"
                         Margin="0 0 0 18"/>

                <!-- Column headers -->
                <Grid ColumnDefinitions="1.2* 1.2* 1.8* 1* 0.8*">

                    <TextBlock Grid.Column="0"
                               HorizontalAlignment="Center"
                               Classes="InvitationColumnHeader"
                               Text="Created"/>

                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               Classes="InvitationColumnHeader"
                               Text="Expires"/>

                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Center"
                               Classes="InvitationColumnHeader"
                               Text="Invitation Code"/>

                    <TextBlock Grid.Column="3"
                               HorizontalAlignment="Center"
                               Classes="InvitationColumnHeader"
                               Text="Used By"/>

                    <TextBlock Grid.Column="4"
                               HorizontalAlignment="Center"
                               Classes="InvitationColumnHeader"
                               Text="Status"/>
                </Grid>

                <!-- Divider -->
                <Separator Height="1"
                           Background="#9c9c91"
                           Opacity="0.6"
                           Margin="10"/>

                <!-- Scrollable list of invitation rows (populated from code-behind) -->
                <ScrollViewer Height="200"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">

                    <Grid x:Name="InviteCodesGrid"
                          ColumnDefinitions="1.2* 1.2* 1.8* 1* 0.8*"
                          VerticalAlignment="Top"/>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </Border>

</Window>
