<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BlockSense.Desktop.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://BlockSense.Desktop/Assets/AppDefaultStyles.axaml"/>
    </Application.Styles>
    
    <Application.Resources>
		<FontFamily x:Key="Montserrat">
            avares://BlockSense.Desktop/Assets/Fonts/Montserrat#Montserrat
		</FontFamily>

		<FontFamily x:Key="Roboto">
            avares://BlockSense.Desktop/Assets/Fonts/Roboto#Roboto
		</FontFamily>

		<FontFamily x:Key="Pacifico">
			avares://BlockSense.Desktop/Assets/Fonts/Pacifico#Pacifico
		</FontFamily>
	</Application.Resources>

</Application>