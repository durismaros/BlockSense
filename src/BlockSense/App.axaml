<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BlockSense.ViewModels"
             xmlns:views="using:BlockSense.Views"
             x:Class="BlockSense.App"
             RequestedThemeVariant="Default">

	<Application.Styles>
		<FluentTheme/>
		<StyleInclude Source="avares://BlockSense/Assets/AppDefaultStyles.axaml"/>
	</Application.Styles>

	<Application.Resources>
		<FontFamily x:Key="Montserrat">
			avares://BlockSense/Assets/Fonts/Montserrat#Montserrat
		</FontFamily>
		<FontFamily x:Key="Roboto">
			avares://BlockSense/Assets/Fonts/Roboto#Roboto
		</FontFamily>
		<FontFamily x:Key="Pacifico">
			avares://BlockSense/Assets/Fonts/Pacifico#Pacifico
		</FontFamily>
	</Application.Resources>

	<Application.DataTemplates>
		<DataTemplate DataType="vm:PlainViewModel">
			<views:PlainView />
		</DataTemplate>

		<DataTemplate DataType="vm:MainViewModel">
			<views:MainView />
		</DataTemplate>

		<DataTemplate DataType="vm:LoginViewModel">
			<views:LoginView />
		</DataTemplate>

		<DataTemplate DataType="vm:WelcomeViewModel">
			<views:WelcomeView />
		</DataTemplate>
	</Application.DataTemplates>

</Application>
